# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Кто может говорить с ботом (через запятую). Пусто — все. Рекомендуется ограничить: это ваши деньги.
ALLOWED_USER_IDS=
# Админы видят причину ошибок модели прямо в чате и могут вызвать /check и /stats
ADMIN_USER_IDS=
# /mood — кто может смотреть её состояние и отношения: all | admin
MOOD_COMMAND=all
DEBOUNCE_SECONDS=2.5

# --- Модели: OpenRouter (один ключ на всё: ответы, память, распознавание голоса) ---
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Пусто = anthropic/claude-opus-5.5 и anthropic/claude-haiku-5.5. Можно любую модель OpenRouter.
MAIN_MODEL=
BACKGROUND_MODEL=
# Запасные модели, если основная недоступна или отказала (через запятую)
MAIN_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
# low | medium | high — для разговора хватает low
MAIN_EFFORT=low
# Потолок ответа вместе с размышлением; OpenRouter резервирует под него деньги заранее
MAIN_MAX_TOKENS=2500

# Эмбеддинги памяти через OpenRouter (дёшево: ~$0.01 за 1M токенов). local — бесплатно, но хуже.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# Голосовые и звук видео — аудио-модель через тот же ключ
STT_PROVIDER=openrouter
OPENROUTER_STT_MODEL=google/gemini-3.1-flash-lite

# --- Альтернатива: любой OpenAI-совместимый API вместо OpenRouter (например бесплатный Gemini) ---
# LLM_API_KEY=ключ_из_aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MAIN_MODEL=gemini-3.5-flash
# BACKGROUND_MODEL=gemini-3.5-flash-lite
# MAIN_FALLBACK_MODELS=gemini-3.5-flash-lite
# EMBEDDING_PROVIDER=local
# Голос через бесплатный Groq Whisper:
# STT_PROVIDER=whisper
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=ключ_из_console.groq.com/keys
# STT_MODEL=whisper-large-v3-turbo

# --- Быстро и бесплатно: Groq (ответ за ~1 с) ---
# LLM_API_KEY=ключ_из_console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MAIN_MODEL=qwen/qwen3.8-27b
# BACKGROUND_MODEL=openai/gpt-oss-20b
# MAIN_FALLBACK_MODELS=openai/gpt-oss-120b
# Фоновые задачи можно вынести на другой сервис, чтобы не тратить лимит основного:
# BACKGROUND_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# BACKGROUND_API_KEY=ключ_Gemini
# LLM_TIMEOUT=60

# --- Альтернатива: прямой Anthropic API (LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MAIN_MODEL=claude-opus-5-5
# BACKGROUND_MODEL=claude-haiku-5-5
# USE_REFUSAL_FALLBACKS=true
# Голос через Whisper-совместимый API (STT_PROVIDER=whisper):
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=gpt-4o-mini-transcribe
# Эмбеддинги Voyage (EMBEDDING_PROVIDER=voyage): VOYAGE_API_KEY=

# --- Интернет: Коломбина сама решает, когда искать и что читать ---
WEB_ENABLED=true
# Поисковики пробуются по порядку: Tavily → Brave → Jina → SearXNG → DuckDuckGo (+ Wikipedia вторым источником).
# Бесплатные ключи: tavily.com (1000/мес), brave.com/search/api (2000/мес), jina.ai (бесплатные токены).
TAVILY_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
SEARXNG_URL=
# Чтение страниц через Jina Reader (работает и без ключа, с ключом — больше лимит)
JINA_ENABLED=true
WEB_SEARCH_REGION=ru-ru
WIKIPEDIA_LANG=ru
WEB_DAILY_LIMIT_PER_USER=60
WEB_PAGE_CHARS=6000
MAX_TOOL_ROUNDS=5

# --- Внутренняя жизнь: сама исследует интересные темы, ведёт дневник, видит сны (в бюджете) ---
INNER_LIFE_ENABLED=true
# Сколько самостоятельных исследований в сутки на собеседника (каждое: до 2 поисков и 2 страниц)
RESEARCH_PER_DAY=2
# Сон — не чаще раза в N дней, ночью по времени собеседника
DREAMS_EVERY_DAYS=3

# --- Запасной сервис модели целиком (если у основного кончился лимит) ---
# SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SECONDARY_API_KEY=ключ_Gemini
# SECONDARY_MODEL=gemini-3.5-flash
# Сколько секунд можно ждать, если сервис просит подождать (дальше — запасная модель)
LLM_MAX_WAIT=15

# --- Зрение для моделей без зрения (Groq qwen/gpt-oss): картинки описывает модель со зрением ---
# MAIN_VISION=auto
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_API_KEY=ключ_Gemini
# VISION_MODEL=gemini-3.5-flash-lite

# --- Голос и стикеры ---
# Голосовые ответы: синтетический голос Gemini (тот же бесплатный ключ AI Studio). Пусто — без голоса.
TTS_API_KEY=
TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts
# Голоса Gemini: Leda, Aoede, Kore, Zephyr…
TTS_VOICE=Leda
# Имя набора стикеров Telegram (из ссылки t.me/addstickers/ИМЯ), которыми она может отвечать
STICKER_SET=
# GIF: бесплатный ключ developers.giphy.com (пусто — без гифок)
GIPHY_API_KEY=
# Кружки: путь к вашей картинке-аватару внутри контейнера (например /app/var/avatar.jpg).
# На кружок она отвечает кружком: ваша картинка + её голос. Пусто — отвечает голосовым.
AVATAR_IMAGE=
# Если планировщик молчит дольше N секунд — процесс перезапускается (Docker поднимет заново)
WATCHDOG_SECONDS=1800

# --- Хранилище ---
# PostgreSQL (docker compose подставит DATABASE_URL сам — нужен только пароль):
POSTGRES_PASSWORD=
# Без Docker: DATABASE_URL=postgresql://user:pass@localhost:5432/columbina
DATABASE_URL=
# Если DATABASE_URL пуст — SQLite-файл (удобно для разработки):
DB_PATH=var/columbina.sqlite3

# --- Поведение ---
DEFAULT_TIMEZONE=Europe/Moscow
INITIATIVE_TICK_SECONDS=600
HISTORY_KEEP_MESSAGES=24
HISTORY_SUMMARIZE_AT=40
CONTEXT_BUDGET_TOKENS=1400
# Контроль расходов: деньги на собеседника в сутки, деньги всего бота в сутки (0 — без лимита),
# число запросов к модели в сутки на собеседника (0 — без лимита; полезно на бесплатных API),
# фоновые запросы (исследования, сны, описание картинок) в сутки на собеседника.
DAILY_BUDGET_USD_PER_USER=3.0
DAILY_BUDGET_USD_TOTAL=0
DAILY_LLM_CALLS_PER_USER=0
BACKGROUND_CALLS_PER_USER=40
# Канон: genshin (названия из игры) | dossier (переименованный мир досье)
CANON_MODE=genshin
# Группы: добавьте бота в группу. Чтобы она «слышала» весь чат (а не только обращения), выключите
# Privacy Mode у бота в @BotFather → Bot Settings → Group Privacy → Turn off.
GROUPS_ENABLED=false
# Группы, где отвечать всем (id через запятую, id группы начинается с -100…). Иначе — только людям из ALLOWED_USER_IDS
ALLOWED_GROUP_IDS=
# Не больше N её ответов за 10 минут в одной группе
GROUP_MAX_REPLIES_PER_10MIN=12
LINK_FETCH_ENABLED=true
# Путь к CA-бандлу, если сервер выходит в интернет через TLS-прокси
LINK_CA_BUNDLE=
