# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Кто может говорить с ботом (через запятую). Пусто — все. Рекомендуется ограничить: это ваши деньги.
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
DEBOUNCE_SECONDS=2.5

# --- Модели: OpenRouter (один ключ на всё: ответы, память, распознавание голоса) ---
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Пусто = anthropic/claude-opus-5.5 и anthropic/claude-haiku-5.5. Можно любую модель OpenRouter.
MAIN_MODEL=
BACKGROUND_MODEL=
# Запасные модели, если основная недоступна или отказала (через запятую)
MAIN_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
# low | medium | high — для разговора хватает low
MAIN_EFFORT=low
MAIN_MAX_TOKENS=4000

# Эмбеддинги памяти через OpenRouter (дёшево: ~$0.01 за 1M токенов). local — бесплатно, но хуже.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# Голосовые и звук видео — аудио-модель через тот же ключ
STT_PROVIDER=openrouter
OPENROUTER_STT_MODEL=google/gemini-3.1-flash-lite

# --- Альтернатива: прямой Anthropic API (LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MAIN_MODEL=claude-opus-5-5
# BACKGROUND_MODEL=claude-haiku-5-5
# USE_REFUSAL_FALLBACKS=true
# Голос через Whisper-совместимый API (STT_PROVIDER=whisper):
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=gpt-4o-mini-transcribe
# Эмбеддинги Voyage (EMBEDDING_PROVIDER=voyage): VOYAGE_API_KEY=

# --- Хранилище ---
# PostgreSQL (docker compose подставит DATABASE_URL сам — нужен только пароль):
POSTGRES_PASSWORD=
# Без Docker: DATABASE_URL=postgresql://user:pass@localhost:5432/columbina
DATABASE_URL=
# Если DATABASE_URL пуст — SQLite-файл (удобно для разработки):
DB_PATH=var/columbina.sqlite3

# --- Поведение ---
DEFAULT_TIMEZONE=Europe/Moscow
INITIATIVE_TICK_SECONDS=600
HISTORY_KEEP_MESSAGES=24
HISTORY_SUMMARIZE_AT=40
CONTEXT_BUDGET_TOKENS=1400
DAILY_BUDGET_USD_PER_USER=3.0
LINK_FETCH_ENABLED=true
# Путь к CA-бандлу, если сервер выходит в интернет через TLS-прокси
LINK_CA_BUNDLE=
