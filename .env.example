# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Кто может говорить с ботом (через запятую). Пусто — все. Рекомендуется ограничить: это ваши деньги.
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
DEBOUNCE_SECONDS=2.5

# --- Anthropic (основная модель и фоновые задачи) ---
ANTHROPIC_API_KEY=
MAIN_MODEL=claude-opus-5-5
BACKGROUND_MODEL=claude-haiku-5-5
# low | medium | high — для разговора хватает low
MAIN_EFFORT=low
MAIN_MAX_TOKENS=4000
USE_REFUSAL_FALLBACKS=true

# --- Эмбеддинги для памяти: local (бесплатно, офлайн) | voyage (лучше понимает смысл) ---
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# --- Распознавание речи: любой Whisper-совместимый endpoint ---
# OpenAI:  https://api.openai.com/v1 + gpt-4o-mini-transcribe
# Groq:    https://api.groq.com/openai/v1 + whisper-large-v3-turbo
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Хранилище ---
# PostgreSQL (docker compose подставит DATABASE_URL сам — нужен только пароль):
POSTGRES_PASSWORD=
# Без Docker: DATABASE_URL=postgresql://user:pass@localhost:5432/columbina
DATABASE_URL=
# Если DATABASE_URL пуст — SQLite-файл (удобно для разработки):
DB_PATH=var/columbina.sqlite3

# --- Поведение ---
DEFAULT_TIMEZONE=Europe/Moscow
INITIATIVE_TICK_SECONDS=600
HISTORY_KEEP_MESSAGES=24
HISTORY_SUMMARIZE_AT=40
CONTEXT_BUDGET_TOKENS=1400
DAILY_BUDGET_USD_PER_USER=3.0
LINK_FETCH_ENABLED=true
# Путь к CA-бандлу, если сервер выходит в интернет через TLS-прокси
LINK_CA_BUNDLE=
